{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    { "source": "/gas.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/CONTINUE.md", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
